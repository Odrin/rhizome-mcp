{{define "boardServedPage"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.Style}}</style>
</head>
<body>
<main data-board-main data-board-endpoint="/api/board" data-board-route="/">
<h1>{{.Title}}</h1>
<p class="generated">Generated {{.GeneratedAt}}</p>
<section>
<h2>Search</h2>
<form data-board-search-form>
<label for="board-search-query">Search</label>
<input id="board-search-query" name="search" type="search" value="{{.SearchQuery}}" />
<select name="entity_type">
<option value="all">All</option>
<option value="issue"{{if eq .SelectedEntityType "issue"}} selected{{end}}>Issue</option>
<option value="comment"{{if eq .SelectedEntityType "comment"}} selected{{end}}>Comment</option>
<option value="decision"{{if eq .SelectedEntityType "decision"}} selected{{end}}>Decision</option>
<option value="review"{{if eq .SelectedEntityType "review"}} selected{{end}}>Review</option>
<option value="attempt_note"{{if eq .SelectedEntityType "attempt_note"}} selected{{end}}>Attempt note</option>
</select>
<button type="submit">Search</button>
</form>
<div data-board-search-status role="status" aria-live="polite">{{.SearchStatusMessage}}</div>
<div data-board-search-results>
{{if .SearchHasResults}}
<ul>
{{range .SearchResults}}
<li><strong>{{.Title}}</strong><div>{{.EntityType}} • {{.EntityID}}</div><div>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}<span class="empty">No owning issue</span>{{end}}</div><div>{{.Snippet}}</div></li>
{{end}}
</ul>
{{if .SearchHasMore}}<button type="button">Load more</button>
{{end}}
{{else if not .SearchIsInitial}}{{if .SearchInvalid}}<p class="empty">Invalid search query.</p>{{else if .SearchError}}<p class="empty">Search temporarily unavailable.</p>{{else}}<p class="empty">No results found.</p>{{end}}{{else}}<p class="empty">Enter a search query to find issues, comments, decisions, reviews, and attempt notes.</p>{{end}}
</div>
</section>
<section>
<h2>Status counts</h2>
{{if .StatusCounts}}
<div class="table-scroll"><table>
<thead><tr><th>Effective status</th><th>Count</th></tr></thead>
<tbody>
{{range .StatusCounts}}<tr><td>{{.Status}}</td><td>{{.Count}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="empty">No issues yet.</p>
{{end}}
</section>
<section>
<h2>Active (leased) attempts</h2>
<p class="generated">{{.ActiveReservationCount}} active resource reservation{{if ne .ActiveReservationCount 1}}s{{end}}, shown grouped under the attempt that holds each one.</p>
{{if .ActiveAttempts}}
<div class="table-scroll"><table>
<thead><tr><th>Attempt</th><th>Issue</th><th>Title</th><th>Kind</th><th>Session label</th><th>Started</th><th>Lease expires</th><th>Reservations</th><th>Gates</th></tr></thead>
<tbody>
{{range .ActiveAttempts}}<tr><td>{{.AttemptID}}</td><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}{{.IssueLabel}}{{end}}</td><td>{{.IssueTitle}}</td><td>{{.Kind}}</td><td>{{.SessionLabel}}</td><td>{{.StartedAt}}</td><td>{{.LeaseExpiresAt}}</td><td>{{if .HasReservations}}<ul class="reservations">{{range .Reservations}}<li>{{.Kind}}: {{.DisplayValue}}</li>
{{end}}</ul>{{else}}—{{end}}</td><td>{{.GateProgress}}{{if .HasGateUnmet}}<ul class="gates">{{range .GateUnmet}}<li>{{.}}</li>
{{end}}</ul>{{end}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="empty">No active attempts.</p>
{{end}}
{{if .ActiveAttemptsTruncated}}<p class="empty">Showing the first 100 active attempts; more exist.</p>{{end}}
{{if .ActiveReservationsTruncated}}<p class="empty">Showing the first 100 resource reservations; more exist.</p>{{end}}
</section>
<section>
<h2>Blocked issues</h2>
{{if .BlockedIssues}}
<div class="table-scroll"><table>
<thead><tr><th>Issue</th><th>Title</th><th>Blocked reason</th></tr></thead>
<tbody>
{{range .BlockedIssues}}<tr><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.Label}}</a>{{else}}{{.Label}}{{end}}</td><td>{{.Title}}</td><td>{{.BlockedReason}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="empty">No blocked issues.</p>
{{end}}
{{if .BlockedIssuesTruncated}}<p class="empty">Showing the first 100 blocked issues; more exist.</p>{{end}}
</section>
<section>
<h2>Open review requests</h2>
{{if .ReviewRequests}}
<div class="table-scroll"><table>
<thead><tr><th>Request</th><th>Issue</th><th>Status</th><th>Target version</th><th>Created</th></tr></thead>
<tbody>
{{range .ReviewRequests}}<tr><td>{{.ID}}</td><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}{{.IssueLabel}}{{end}}</td><td>{{.Status}}</td><td>{{.TargetVersion}}</td><td>{{.CreatedAt}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="empty">No open review requests.</p>
{{end}}
{{if .ReviewRequestsTruncated}}<p class="empty">Showing the first 100 open review requests; more exist.</p>{{end}}
</section>
<section>
<h2>Planning graph</h2>
<p>{{.PlanningGraphSummary}}</p>
<div class="graph">{{.PlanningGraphSVG}}</div>
<details>
<summary>Mermaid source (copy into any Mermaid renderer)</summary>
<pre>{{.PlanningGraphMermaid}}</pre>
</details>
</section>
</main>
<script>{{.LiveRefreshScript}}</script>
<script>{{.SearchScript}}</script>
<footer>Generated locally by <code>rhizome-mcp board --serve</code>.</footer>
</body>
</html>
{{end}}