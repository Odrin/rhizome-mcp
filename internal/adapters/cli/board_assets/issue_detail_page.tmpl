{{define "boardIssueDetailPage"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.Style}}</style>
</head>
<body>
<main data-board-main data-board-endpoint="{{.BoardEndpoint}}" data-board-route="{{.BoardRoute}}">
<p><a href="{{.ReturnHref}}">Return to board</a></p>
<h1>{{.IssueHeading}}</h1>
<p class="generated">{{.StatusLine}}</p>
<section>
<h2>Metadata</h2>
{{range .Metadata}}<p><strong>{{.Label}}:</strong> {{.Value}}</p>
{{end}}
</section>
<section>
<h2>Labels</h2>
{{if .HasLabels}}<p>{{range $index, $label := .Labels}}{{if $index}}, {{end}}{{$label}}{{end}}</p>{{else}}<p class="empty">No labels assigned.</p>{{end}}
</section>
<section>
<h2>{{.Description.Heading}}</h2>
{{if .Description.IsEmpty}}<p class="empty">{{.Description.EmptyMessage}}</p>{{else}}<pre>{{.Description.Value}}</pre>{{end}}
</section>
<section>
<h2>{{.AcceptanceCriteria.Heading}}</h2>
{{if .AcceptanceCriteria.IsEmpty}}<p class="empty">{{.AcceptanceCriteria.EmptyMessage}}</p>{{else}}<pre>{{.AcceptanceCriteria.Value}}</pre>{{end}}
</section>
<section>
<h2>{{.BlockedReason.Heading}}</h2>
{{if .BlockedReason.IsEmpty}}<p class="empty">{{.BlockedReason.EmptyMessage}}</p>{{else}}<pre>{{.BlockedReason.Value}}</pre>{{end}}
</section>
<section>
<h2>Workflow gates</h2>
<p{{if .Gates.NoneApply}} class="empty"{{end}}>{{.Gates.StatusLine}}</p>
{{if .Gates.HasUnmet}}
<div class="table-scroll"><table>
<thead><tr><th scope="col">Requirement</th><th scope="col">Reason</th><th scope="col">Next action</th></tr></thead>
<tbody>
{{range .Gates.Unmet}}<tr><td>{{.RequirementKey}}</td><td>{{.Reason}}</td><td>{{.NextAction}}</td></tr>
{{end}}</tbody>
</table></div>
{{else if .Gates.Satisfied}}<p>All gate requirements are satisfied.</p>{{end}}
</section>
{{if .RootIssue}}<section>
<h2>Root issue</h2>
<p><a href="{{.RootIssue.Href}}">{{.RootIssue.Label}}</a></p>
</section>{{end}}
{{if .LatestAttempt}}<section>
<h2>Latest attempt</h2>
<p>{{.LatestAttempt.ID}}{{if .LatestAttempt.HasStarted}} — {{.LatestAttempt.StartedAt}}{{end}}</p>
</section>{{end}}
{{if .OpenReview}}<section>
<h2>Open review</h2>
<p>{{.OpenReview.ID}}{{if .OpenReview.HasStatus}} — {{.OpenReview.Status}}{{end}}</p>
</section>{{end}}
{{if .LatestDecision}}<section>
<h2>Latest decision</h2>
<p>{{.LatestDecision.Title}}{{if .LatestDecision.HasSummary}} — {{.LatestDecision.Summary}}{{end}}</p>
</section>{{end}}
{{if .GraphSVG}}<section>
<h2>Related graph</h2>
{{.GraphSVG}}
</section>{{end}}
<section>
<h2>Reservations</h2>
{{if .HasMoreReservations}}<p class="empty">Additional reservations are available.</p>{{end}}
{{if .HasReservations}}
<div class="table-scroll"><table>
<thead><tr><th>Kind</th><th>Display value</th><th>Status</th><th>Created</th><th>Released</th></tr></thead>
<tbody>
{{range .Reservations}}<tr><td>{{.Kind}}</td><td>{{.DisplayValue}}</td><td>{{.Status}}</td><td>{{.CreatedAt}}</td><td>{{if .HasReleased}}{{.ReleasedAt}}{{else}}—{{end}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="empty">No current or historical reservations.</p>
{{end}}
</section>
<section>
<h2>Recent activity</h2>
{{if .Activity.Items}}
{{if .Activity.HasMore}}<p class="empty">Additional activity is available.</p>{{end}}
<ul>
{{range .Activity.Items}}<li>{{.Summary}}{{if .HasDate}} <span class="generated">{{.OccurredAt}}</span>{{end}}</li>
{{end}}</ul>
{{else}}<p class="empty">No activity recorded yet.</p>{{end}}
</section>
</main>
<script>{{.LiveRefreshScript}}</script>
<footer>Generated locally by <code>rhizome-mcp board --serve</code>.</footer>
</body>
</html>
{{end}}